  "definitions": [
    {
      "id": "D1",
      "term": "total flying insect biomass",
      "kind": "variable",
      "definition": "Alcohol-wet mass of all insects caught by a Malaise trap, per day of exposure, weighed after draining through a 0.8 mm sieve."
    },
    {
      "id": "D2",
      "term": "Malaise trap sampling",
      "kind": "method",
      "definition": "Standardised bi-coloured Malaise traps (Townes design) run continuously from March to October and emptied about every 11 days; catches stored in 80% ethanol."
    },
    {
      "id": "D3",
      "term": "German protected areas",
      "kind": "setting",
      "definition": "63 lowland locations in protected areas (Natura 2000 sites, nature reserves, landscape protection areas, water protection zones) in North Rhine-Westphalia (57), Brandenburg (5) and Rhineland-Palatinate (1), 1989-2016; 96 location-years, 1,503 samples.",
      "identifiers": [
        "wikidata:Q183"
      ]
    },
    {
      "id": "D11",
      "term": "flying insects",
      "kind": "organism",
      "definition": "All insects caught in flight by the traps, not identified further.",
      "identifiers": [
        "ncbitaxon:50557"
      ]
    },
    {
      "id": "D4",
      "term": "Bayesian hierarchical biomass model",
      "kind": "method",
      "definition": "Daily latent biomass log-normal with a location random effect and a log-linear annual trend; observed catches are sums of daily biomass over exposure intervals; fitted by MCMC in JAGS."
    },
    {
      "id": "D5",
      "term": "annual decline rate",
      "kind": "variable",
      "definition": "Percentage decrease of expected daily biomass per year, from the model's trend coefficient."
    },
    {
      "id": "D6",
      "term": "seasonal decline over 27 years",
      "kind": "variable",
      "definition": "Percentage decrease of biomass over 1989-2016, weighted over the season (April-October)."
    },
    {
      "id": "D7",
      "term": "weather, land use and habitat",
      "kind": "concept",
      "definition": "Temperature, precipitation, wind, frost and winter rain; forest, agriculture, grassland and water cover within 200 m; plant richness and Ellenberg indicator values within 50 m."
    },
    {
      "id": "D8",
      "term": "habitat cluster",
      "kind": "setting",
      "definition": "Grouping of locations by vegetation: 1 nutrient-poor heathland, sandy grassland and dunes; 2 nutrient-rich grassland, margins and wasteland; 3 pioneer and shrub communities.",
      "members": [
        "D9",
        "D10"
      ]
    },
    {
      "id": "D9",
      "term": "nutrient-poor heathland, sandy grassland and dunes",
      "kind": "setting",
      "definition": "Habitat cluster 1 (19 locations)."
    },
    {
      "id": "D10",
      "term": "nutrient-rich grassland, margins and wasteland",
      "kind": "setting",
      "definition": "Habitat cluster 2 (41 locations)."
    }
  ],
