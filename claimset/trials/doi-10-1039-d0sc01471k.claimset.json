  "definitions": [
    {
      "id": "D1",
      "term": "vinylation/arylation cascade",
      "kind": "method",
      "definition": "One-step reaction of a cyclic alkyl oxalate (caesium salt), a terminal alkyne and an aryl halide: decarboxylative alkyl radical addition to the alkyne, 1,5-hydrogen atom transfer from the ring to the vinyl radical, and nickel-catalysed arylation of the ring carbon radical."
    },
    {
      "id": "D2",
      "term": "standard conditions",
      "kind": "method",
      "definition": "Alkyne 0.1 mmol, cyclic oxalate 3.0 equiv, aryl halide 2.0 equiv, Ir[dF(CF3)ppy]2(dtbbpy)PF6 2 mol%, NiCl2(Py)4 20 mol%, dtbbpy 20 mol%, bis(4-methoxyphenyl)methanone 10 mol%, DMSO 0.05 M, 37 °C, 90 W blue LEDs."
    },
    {
      "id": "D3",
      "term": "1,3-vinylarylated cycloalkanes",
      "kind": "substance",
      "definition": "Products carrying a trans-alkenyl group and an aryl group on carbons 1 and 3 of a saturated ring, formed as roughly 1:1 to 1:1.2 mixtures of diastereomers."
    },
    {
      "id": "D4",
      "term": "yield",
      "kind": "variable",
      "definition": "Isolated yield of product based on the alkyne, unless the source marks it as a crude 1H NMR yield."
    },
