  "definitions": [
    {
      "id": "D1",
      "term": "dietary support",
      "kind": "intervention",
      "definition": "Seven individual sessions of about 60 minutes with a clinical dietitian over 12 weeks (weekly for four, then fortnightly), promoting a modified Mediterranean diet (ModiMedDiet), added to usual treatment."
    },
    {
      "id": "D2",
      "term": "social support",
      "kind": "intervention",
      "definition": "Befriending: seven sessions of the same schedule and length with a trained person, without dietary content; the attention control."
    },
    {
      "id": "D3",
      "term": "adults with moderate to severe depression and poor diet",
      "kind": "population",
      "definition": "Adults 18 or older with a current major depressive episode (DSM-IV-TR), MADRS 18 or higher, and a Dietary Screening Tool score of 75 or less; 67 randomised at two sites in Victoria, Australia."
    },
    {
      "id": "D4",
      "term": "MADRS",
      "kind": "variable",
      "definition": "Montgomery-Asberg Depression Rating Scale, clinician-rated, 0-60; higher is more severe. The primary outcome, at 12 weeks."
    },
    {
      "id": "D5",
      "term": "remission",
      "kind": "variable",
      "definition": "MADRS below 10 at 12 weeks."
    },
    {
      "id": "D6",
      "term": "HADS depression",
      "kind": "variable",
      "definition": "Depression subscale of the Hospital Anxiety and Depression Scale, self-report."
    },
    {
      "id": "D7",
      "term": "single-blind parallel-group trial",
      "kind": "design",
      "definition": "Two-arm, 12-week randomised trial; computer-generated sequence in blocks of four; outcome assessors and statistician blinded, participants not; analysis by intention to treat with a mixed model for repeated measures (missing at random)."
    },
    {
      "id": "D8",
      "term": "trial arm",
      "kind": "intervention",
      "definition": "The arms of the trial.",
      "members": [
        "D1",
        "D2"
      ]
    }
  ],
